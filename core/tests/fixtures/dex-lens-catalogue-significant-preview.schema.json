{
  "$comment": "This contract requires the Dex Lens unique-by vocabulary. Vanilla Draft 2020-12 validation alone is incomplete; use the declared dialect and capability_exchange.catalogue.schema_contract.iter_catalogue_schema_errors.",
  "$defs": {
    "ActiveSkillCapabilityEntryV2": {
      "additionalProperties": false,
      "description": "An enriched skill entry: the legacy skill shape plus the class fields.\n\nA skill keeps every legacy field \u2014 compatibility, docs_url,\nsince_release, changed_in and the portable rebuild brief are skill-only\nand stay required here, and only here. A dormant skill still validates;\nconsumers must never offer it as an active recommendation.",
      "properties": {
        "availability": {
          "enum": [
            "active",
            "dormant"
          ],
          "title": "Availability",
          "type": "string"
        },
        "capability_class": {
          "const": "active-skill",
          "title": "Capability Class",
          "type": "string"
        },
        "capability_id": {
          "pattern": "^[a-z][a-z0-9-]{2,80}$",
          "title": "Capability Id",
          "type": "string"
        },
        "changed_in": {
          "items": {
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "type": "string"
          },
          "maxItems": 40,
          "title": "Changed In",
          "type": "array",
          "uniqueItems": true
        },
        "compatibility": {
          "$ref": "#/$defs/CapabilityCompatibilityV2"
        },
        "docs_url": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Docs Url",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CapabilityEvidenceV2"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "impact_tier": {
          "enum": [
            "core",
            "high",
            "medium",
            "niche"
          ],
          "title": "Impact Tier",
          "type": "string"
        },
        "jobs": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{2,80}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Jobs",
          "type": "array",
          "uniqueItems": true
        },
        "portable_brief": {
          "$ref": "#/$defs/CapabilityPortableBriefV2"
        },
        "prerequisites": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Prerequisites",
          "type": "array"
        },
        "release_provenance": {
          "const": "core-release",
          "title": "Release Provenance",
          "type": "string"
        },
        "since_release": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Since Release",
          "type": "string"
        },
        "summary": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 140,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trade_offs": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Trade Offs",
          "type": "array"
        },
        "value": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "capability_class",
        "impact_tier",
        "availability",
        "capability_id",
        "title",
        "summary",
        "value",
        "jobs",
        "prerequisites",
        "trade_offs",
        "evidence",
        "compatibility",
        "docs_url",
        "since_release",
        "changed_in",
        "release_provenance",
        "portable_brief"
      ],
      "title": "ActiveSkillCapabilityEntryV2",
      "type": "object"
    },
    "AutomaticAssessmentV2": {
      "additionalProperties": false,
      "description": "A closed reference to one built-in read-only detector profile.",
      "properties": {
        "mode": {
          "const": "automatic",
          "title": "Mode",
          "type": "string"
        },
        "profile": {
          "enum": [
            "catalogue",
            "mcp",
            "mcp-tool",
            "filesystem",
            "source-component",
            "provider",
            "scheduled-automation",
            "health",
            "doctor"
          ],
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "profile"
      ],
      "title": "AutomaticAssessmentV2",
      "type": "object"
    },
    "CapabilityAliasV2": {
      "additionalProperties": false,
      "description": "One human-friendly alias for a canonical signed capability id.",
      "properties": {
        "alias": {
          "pattern": "^[a-z][a-z0-9-]{2,80}$",
          "title": "Alias",
          "type": "string"
        },
        "capability_id": {
          "pattern": "^[a-z][a-z0-9-]{2,80}$",
          "title": "Capability Id",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "capability_id"
      ],
      "title": "CapabilityAliasV2",
      "type": "object"
    },
    "CapabilityCompatibilityV2": {
      "additionalProperties": false,
      "properties": {
        "foundation_capabilities": {
          "items": {
            "enum": [
              "ownership-portability",
              "privacy-minimal-disclosure",
              "context-orientation",
              "durable-memory-provenance",
              "scoped-agency-human-control",
              "safe-change-recovery",
              "honest-health-observability",
              "compounding-correctability"
            ],
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Foundation Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "host_adapters": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{1,80}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Host Adapters",
          "type": "array",
          "uniqueItems": true
        },
        "host_requirements": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{2,80}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Host Requirements",
          "type": "array",
          "uniqueItems": true
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "minimum_lens_contract": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Minimum Lens Contract",
          "type": "string"
        },
        "needs_hooks": {
          "title": "Needs Hooks",
          "type": "boolean"
        },
        "needs_mcp": {
          "title": "Needs Mcp",
          "type": "boolean"
        },
        "platforms": {
          "items": {
            "enum": [
              "macos",
              "linux",
              "windows"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Platforms",
          "type": "array"
        }
      },
      "required": [
        "host_adapters",
        "foundation_capabilities",
        "minimum_lens_contract",
        "platforms",
        "needs_hooks",
        "needs_mcp",
        "host_requirements",
        "limitations"
      ],
      "title": "CapabilityCompatibilityV2",
      "type": "object"
    },
    "CapabilityEvidenceV2": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "verified",
            "supported",
            "reported",
            "unknown"
          ],
          "title": "Level",
          "type": "string"
        },
        "limitations": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Limitations",
          "type": "string"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "level",
        "source",
        "summary",
        "limitations"
      ],
      "title": "CapabilityEvidenceV2",
      "type": "object"
    },
    "CapabilityFamilyV2": {
      "additionalProperties": false,
      "description": "A signed outcome family whose state is derived from its leaf members.\n\nAvailability is deliberately absent.  The only trustworthy status is\ncalculated by :mod:`capability_exchange.diagnosis.families` from the\nmember entries' existing ``capability_is_active`` result.",
      "properties": {
        "aliases": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{2,80}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Aliases",
          "type": "array",
          "uniqueItems": true
        },
        "assessment": {
          "discriminator": {
            "mapping": {
              "automatic": "#/$defs/AutomaticAssessmentV2",
              "manual-only": "#/$defs/ManualOnlyAssessmentV2"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AutomaticAssessmentV2"
            },
            {
              "$ref": "#/$defs/ManualOnlyAssessmentV2"
            }
          ],
          "title": "Assessment"
        },
        "components": {
          "items": {
            "discriminator": {
              "mapping": {
                "capability": "#/$defs/CapabilityReferenceV2",
                "mcp-tool": "#/$defs/McpToolReferenceV2",
                "nango-provider": "#/$defs/NangoProviderReferenceV2",
                "source-component": "#/$defs/SourceComponentReferenceV2"
              },
              "propertyName": "component_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CapabilityReferenceV2"
              },
              {
                "$ref": "#/$defs/McpToolReferenceV2"
              },
              {
                "$ref": "#/$defs/NangoProviderReferenceV2"
              },
              {
                "$ref": "#/$defs/SourceComponentReferenceV2"
              }
            ]
          },
          "maxItems": 120,
          "minItems": 1,
          "title": "Components",
          "type": "array",
          "uniqueItems": true,
          "x-dex-lens-unique-component-identity": true
        },
        "family_id": {
          "pattern": "^[a-z][a-z0-9-]{2,80}$",
          "title": "Family Id",
          "type": "string"
        },
        "jobs": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{2,80}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Jobs",
          "type": "array",
          "uniqueItems": true
        },
        "member_capability_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{2,80}$",
            "type": "string"
          },
          "maxItems": 80,
          "minItems": 1,
          "title": "Member Capability Ids",
          "type": "array",
          "uniqueItems": true
        },
        "outcome": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "title": {
          "maxLength": 140,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "family_id",
        "title",
        "outcome",
        "jobs",
        "aliases",
        "member_capability_ids",
        "components",
        "assessment"
      ],
      "title": "CapabilityFamilyV2",
      "type": "object"
    },
    "CapabilityPortableBriefV2": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "method_outline": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Method Outline",
          "type": "array"
        },
        "rollback_advice": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Rollback Advice",
          "type": "string"
        },
        "safety_notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Safety Notes",
          "type": "array"
        },
        "verification_checklist": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Verification Checklist",
          "type": "array"
        }
      },
      "required": [
        "goal",
        "method_outline",
        "verification_checklist",
        "rollback_advice",
        "safety_notes"
      ],
      "title": "CapabilityPortableBriefV2",
      "type": "object"
    },
    "CapabilityReferenceV2": {
      "additionalProperties": false,
      "description": "A component that points to one signed catalogue capability.",
      "properties": {
        "capability_id": {
          "pattern": "^[a-z][a-z0-9-]{2,80}$",
          "title": "Capability Id",
          "type": "string"
        },
        "component_type": {
          "const": "capability",
          "title": "Component Type",
          "type": "string"
        }
      },
      "required": [
        "component_type",
        "capability_id"
      ],
      "title": "CapabilityReferenceV2",
      "type": "object"
    },
    "CatalogueCapabilityEntryV2": {
      "oneOf": [
        {
          "$ref": "#/$defs/LegacySkillCapabilityEntryV2"
        },
        {
          "$ref": "#/$defs/ActiveSkillCapabilityEntryV2"
        },
        {
          "$ref": "#/$defs/McpServerCapabilityEntryV2"
        },
        {
          "$ref": "#/$defs/ScheduledAutomationCapabilityEntryV2"
        },
        {
          "$ref": "#/$defs/SystemEngineCapabilityEntryV2"
        }
      ],
      "title": "CatalogueCapabilityEntryV2"
    },
    "CatalogueMetadataV2": {
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "minimum": 1,
          "title": "Catalog Version",
          "type": "integer"
        },
        "contract_version": {
          "const": "dex-lens-catalogue-v2",
          "title": "Contract Version",
          "type": "string"
        },
        "core_release": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Core Release",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "key_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "producer": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "catalog_version",
        "produced_at",
        "expires_at",
        "producer",
        "core_release",
        "key_id"
      ],
      "title": "CatalogueMetadataV2",
      "type": "object"
    },
    "CatalogueV2": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/CatalogueCapabilityEntryV2"
          },
          "maxItems": 300,
          "minItems": 1,
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true,
          "x-dex-lens-unique-by": "capability_id"
        },
        "capability_aliases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityAliasV2"
          },
          "maxItems": 300,
          "title": "Capability Aliases",
          "type": "array",
          "uniqueItems": true,
          "x-dex-lens-unique-by": "alias"
        },
        "capability_families": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityFamilyV2"
          },
          "maxItems": 80,
          "title": "Capability Families",
          "type": "array",
          "uniqueItems": true,
          "x-dex-lens-unique-by": "family_id"
        },
        "jobs_taxonomy": {
          "items": {
            "$ref": "#/$defs/JobTaxonomyEntryV2"
          },
          "maxItems": 80,
          "minItems": 1,
          "title": "Jobs Taxonomy",
          "type": "array",
          "uniqueItems": true,
          "x-dex-lens-unique-by": "job_id"
        },
        "portable_brief": {
          "$ref": "#/$defs/PortableBriefContractV2"
        }
      },
      "required": [
        "jobs_taxonomy",
        "capabilities",
        "portable_brief"
      ],
      "title": "CatalogueV2",
      "type": "object"
    },
    "JobTaxonomyEntryV2": {
      "additionalProperties": false,
      "properties": {
        "confirmed_gap_signals": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Confirmed Gap Signals",
          "type": "array"
        },
        "description": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[a-z][a-z0-9-]{2,80}$",
          "title": "Job Id",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "label",
        "description",
        "confirmed_gap_signals"
      ],
      "title": "JobTaxonomyEntryV2",
      "type": "object"
    },
    "LegacySkillCapabilityEntryV2": {
      "additionalProperties": false,
      "description": "A skill entry exactly as every already-signed catalogue publishes it.\n\nThis is the transition branch of the 0.1.9 contract: the currently\npublished catalogue is skill-only and its entries carry none of the\nclass fields, so this model stays byte-for-byte what those signed\ncatalogues were validated against. It is closed and skill-shaped \u2014\nevery skill field is required and unknown fields are rejected \u2014 so a\nclassless non-skill entry cannot slip in through it. Removing this\nbranch is a later, explicit compatibility decision once every supported\nCore catalogue carries the enriched fields.",
      "properties": {
        "capability_id": {
          "pattern": "^[a-z][a-z0-9-]{2,80}$",
          "title": "Capability Id",
          "type": "string"
        },
        "changed_in": {
          "items": {
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "type": "string"
          },
          "maxItems": 40,
          "title": "Changed In",
          "type": "array",
          "uniqueItems": true
        },
        "compatibility": {
          "$ref": "#/$defs/CapabilityCompatibilityV2"
        },
        "docs_url": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Docs Url",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CapabilityEvidenceV2"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "jobs": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{2,80}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Jobs",
          "type": "array",
          "uniqueItems": true
        },
        "portable_brief": {
          "$ref": "#/$defs/CapabilityPortableBriefV2"
        },
        "prerequisites": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Prerequisites",
          "type": "array"
        },
        "release_provenance": {
          "const": "core-release",
          "title": "Release Provenance",
          "type": "string"
        },
        "since_release": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Since Release",
          "type": "string"
        },
        "summary": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 140,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trade_offs": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Trade Offs",
          "type": "array"
        },
        "value": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "title",
        "summary",
        "value",
        "jobs",
        "prerequisites",
        "trade_offs",
        "evidence",
        "compatibility",
        "docs_url",
        "since_release",
        "changed_in",
        "release_provenance",
        "portable_brief"
      ],
      "title": "LegacySkillCapabilityEntryV2",
      "type": "object"
    },
    "ManualOnlyAssessmentV2": {
      "additionalProperties": false,
      "description": "A family that intentionally needs a human review rather than a detector.",
      "properties": {
        "mode": {
          "const": "manual-only",
          "title": "Mode",
          "type": "string"
        },
        "reason": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "reason"
      ],
      "title": "ManualOnlyAssessmentV2",
      "type": "object"
    },
    "McpServerCapabilityEntryV2": {
      "additionalProperties": false,
      "description": "An MCP server Dex runs: adopted by running Dex, never rebuilt from a page.\n\nThe catalogue id stays kebab-case; the server's own name is preserved\nseparately as ``server_name``. No skill-only field is permitted here.",
      "properties": {
        "availability": {
          "const": "active",
          "title": "Availability",
          "type": "string"
        },
        "capability_class": {
          "const": "mcp-server",
          "title": "Capability Class",
          "type": "string"
        },
        "capability_id": {
          "pattern": "^[a-z][a-z0-9-]{2,80}$",
          "title": "Capability Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CapabilityEvidenceV2"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "example_tools": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Example Tools",
          "type": "array",
          "uniqueItems": true
        },
        "impact_tier": {
          "enum": [
            "core",
            "high",
            "medium",
            "niche"
          ],
          "title": "Impact Tier",
          "type": "string"
        },
        "jobs": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{2,80}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Jobs",
          "type": "array",
          "uniqueItems": true
        },
        "prerequisites": {
          "items": {
