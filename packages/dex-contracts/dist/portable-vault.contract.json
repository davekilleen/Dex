{
  "contract_version": 2,
  "source": "core/portable_contract.py",
  "vault_schema_supported": ">=1 <2",
  "ownership_classes": [
    "brain",
    "vault",
    "seed",
    "generated",
    "runtime"
  ],
  "mutation_policy": {
    "brain": "replace",
    "generated": "regenerate",
    "runtime": "never",
    "seed": "write-if-absent",
    "vault": "never"
  },
  "customization_migration": {
    "version": 0,
    "action": "write-with-user-approval",
    "seam_prefixes": [
      "System/.dex/customization-migrations/"
    ],
    "seam_paths": [
      "CLAUDE-custom.md"
    ]
  },
  "hard_deny": [
    ".env",
    ".env.*",
    ".git",
    ".git/*",
    "System/credentials",
    "System/credentials/*",
    "*token.json",
    "*.key",
    "*.pem"
  ],
  "vault_regions": [
    "00-Inbox",
    "01-Quarter_Goals",
    "02-Week_Priorities",
    "03-Tasks",
    "04-Projects",
    "05-Areas",
    "06-Resources",
    "07-Archives"
  ],
